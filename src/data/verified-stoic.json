[
  {
    "text": "Одні речі залежать від нас, інші — ні.",
    "author": "Епіктет",
    "reference": "Енхірідіон, 1",
    "sourceUrl": "https://classics.mit.edu/Epictetus/epicench.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Людей тривожать не речі, а судження про них.",
    "author": "Епіктет",
    "reference": "Енхірідіон, 5",
    "sourceUrl": "https://classics.mit.edu/Epictetus/epicench.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Бажай, щоб події відбувалися так, як відбуваються.",
    "author": "Епіктет",
    "reference": "Енхірідіон, 8",
    "sourceUrl": "https://classics.mit.edu/Epictetus/epicench.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Хвороба заважає тілу, але не обов’язково твоєму вибору.",
    "author": "Епіктет",
    "reference": "Енхірідіон, 9",
    "sourceUrl": "https://classics.mit.edu/Epictetus/epicench.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Перед труднощами запитай себе, яку здатність можеш застосувати.",
    "author": "Епіктет",
    "reference": "Енхірідіон, 10",
    "sourceUrl": "https://classics.mit.edu/Epictetus/epicench.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Починай із малого: спокій теж має свою ціну.",
    "author": "Епіктет",
    "reference": "Енхірідіон, 12",
    "sourceUrl": "https://classics.mit.edu/Epictetus/epicench.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Заради поступу погодься здаватися нерозумним у зовнішніх справах.",
    "author": "Епіктет",
    "reference": "Енхірідіон, 13",
    "sourceUrl": "https://classics.mit.edu/Epictetus/epicench.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Твоя справа — добре зіграти дану роль, а не вибирати її.",
    "author": "Епіктет",
    "reference": "Енхірідіон, 17",
    "sourceUrl": "https://classics.mit.edu/Epictetus/epicench.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Не вступай у змагання, де перемога не залежить від тебе.",
    "author": "Епіктет",
    "reference": "Енхірідіон, 19",
    "sourceUrl": "https://classics.mit.edu/Epictetus/epicench.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Коли тебе провокують, дай собі час перед відповіддю.",
    "author": "Епіктет",
    "reference": "Енхірідіон, 20",
    "sourceUrl": "https://classics.mit.edu/Epictetus/epicench.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Не віддавай свій розум у владу чужих образ.",
    "author": "Епіктет",
    "reference": "Енхірідіон, 28",
    "sourceUrl": "https://classics.mit.edu/Epictetus/epicench.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Перед кожною справою обміркуй її передумови й наслідки.",
    "author": "Епіктет",
    "reference": "Енхірідіон, 29",
    "sourceUrl": "https://classics.mit.edu/Epictetus/epicench.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Виконуй кожну справу так, ніби вона остання в житті.",
    "author": "Марк Аврелій",
    "reference": "Роздуми, II.5",
    "sourceUrl": "https://classics.mit.edu/Antoninus/meditations.2.two.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Можна піти з життя вже зараз — нехай це визначає твої вчинки.",
    "author": "Марк Аврелій",
    "reference": "Роздуми, II.11",
    "sourceUrl": "https://classics.mit.edu/Antoninus/meditations.2.two.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Ніхто не втрачає іншого життя, ніж те, яким живе зараз.",
    "author": "Марк Аврелій",
    "reference": "Роздуми, II.14",
    "sourceUrl": "https://classics.mit.edu/Antoninus/meditations.2.two.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Людська душа шкодить собі, коли діє без мети.",
    "author": "Марк Аврелій",
    "reference": "Роздуми, II.16",
    "sourceUrl": "https://classics.mit.edu/Antoninus/meditations.2.two.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Ніде немає спокійнішого прихистку, ніж у власній душі.",
    "author": "Марк Аврелій",
    "reference": "Роздуми, IV.3",
    "sourceUrl": "https://classics.mit.edu/Antoninus/meditations.4.four.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Не живи так, ніби маєш десять тисяч років. Поки можеш — будь добрим.",
    "author": "Марк Аврелій",
    "reference": "Роздуми, IV.17",
    "sourceUrl": "https://classics.mit.edu/Antoninus/meditations.4.four.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Час — ріка подій: щойно щось з’явилося, течія вже несе його далі.",
    "author": "Марк Аврелій",
    "reference": "Роздуми, IV.43",
    "sourceUrl": "https://classics.mit.edu/Antoninus/meditations.4.four.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Будь як скеля: хвилі б’ються об неї, а вона стоїть непохитно.",
    "author": "Марк Аврелій",
    "reference": "Роздуми, IV.49",
    "sourceUrl": "https://classics.mit.edu/Antoninus/meditations.4.four.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Найкраща помста — не стати схожим на кривдника.",
    "author": "Марк Аврелій",
    "reference": "Роздуми, VI.6",
    "sourceUrl": "https://classics.mit.edu/Antoninus/meditations.6.six.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Залишайся простим, добрим і справедливим; допомагай людям.",
    "author": "Марк Аврелій",
    "reference": "Роздуми, VI.30",
    "sourceUrl": "https://classics.mit.edu/Antoninus/meditations.6.six.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Пристосовуйся до обставин і щиро люби людей, із якими живеш.",
    "author": "Марк Аврелій",
    "reference": "Роздуми, VI.39",
    "sourceUrl": "https://classics.mit.edu/Antoninus/meditations.6.six.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Я охоче зміню свою думку, якщо мені покажуть, що вона хибна.",
    "author": "Марк Аврелій",
    "reference": "Роздуми, VI.21",
    "sourceUrl": "https://classics.mit.edu/Antoninus/meditations.6.six.html",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Бережи свій час: його забирають, викрадають або він непомітно вислизає.",
    "author": "Сенека",
    "reference": "Листи до Луцілія, 1.1",
    "sourceUrl": "https://en.wikisource.org/wiki/Moral_letters_to_Lucilius/Letter_1",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Поки ми відкладаємо життя, воно минає.",
    "author": "Сенека",
    "reference": "Листи до Луцілія, 1.2",
    "sourceUrl": "https://en.wikisource.org/wiki/Moral_letters_to_Lucilius/Letter_1",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Ніщо не належить нам так, як час.",
    "author": "Сенека",
    "reference": "Листи до Луцілія, 1.3",
    "sourceUrl": "https://en.wikisource.org/wiki/Moral_letters_to_Lucilius/Letter_1",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Бути всюди — означає бути ніде.",
    "author": "Сенека",
    "reference": "Листи до Луцілія, 2.2",
    "sourceUrl": "https://en.wikisource.org/wiki/Moral_letters_to_Lucilius/Letter_2",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Бідний той, хто прагне більшого, а не той, хто має мало.",
    "author": "Сенека",
    "reference": "Листи до Луцілія, 2.6",
    "sourceUrl": "https://en.wikisource.org/wiki/Moral_letters_to_Lucilius/Letter_2",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  },
  {
    "text": "Ми частіше страждаємо в уяві, ніж насправді.",
    "author": "Сенека",
    "reference": "Листи до Луцілія, 13.4",
    "sourceUrl": "https://en.wikisource.org/wiki/Moral_letters_to_Lucilius/Letter_13",
    "translation": "Власний український переказ",
    "verifiedAt": "2026-10-04"
  }
]
