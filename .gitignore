# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
# React-дашборд (web/app) білдиться сюди — генерований артефакт, не комітимо
# (роадмеп v3, E0). Деплой: спершу `npm --prefix web/app run build`, тоді
# `wrangler deploy` з web/. Прод-index.html на / лишається комітованим окремо.
/web/public/app/

# Стан живе лише в гілці `state` (§4.3) — не комітимо на гілках коду.
# brief.yml форсує git add -f у власному checkout гілки state.
/state.json

# Secrets — НІКОЛИ не комітимо (§8)
.env
.env.*
!.env.example

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db

# Python (research/checkin_model.py — специфікація-оракул, не деплоїться)
__pycache__/
*.pyc
.idea/
.vscode/

other/
# wrangler local state (KV cache, dev)
.wrangler/

# Python bytecode cache — генерується при запуску скіл-скриптів (.claude/skills/*)
__pycache__/
*.pyc

# Local audit workspace (Cowork session outputs — not versioned)
.workspace/

# --- Claude Code ---
# ⚠️ Локальні налаштування: можуть містити дозволи й шляхи КОНКРЕТНОЇ машини.
# Захист доти тримався на ~/.config/git/ignore однієї машини — тобто на новому
# клоні цей файл пішов би в коміт. Правило мусить жити в репозиторії.
.claude/settings.local.json

# Вендорений сторонній скіл: ~1,9 МБ CSV (google-fonts, styles, products, 22
# стеки) БЕЗ ліцензії апстріму й без ATTRIBUTION — перерозповсюдження чужого
# датасету у власному репо. Лишається локально, ставиться з апстріму:
# github.com/nextlevelbuilder/ui-ux-pro-max-skill
.claude/skills/ui-ux-pro-max/
