# Svitanok — приклад env-змінних.
# Скопіюй у .env (gitignored) і заповни значеннями. У CI — через GitHub Secrets.
# НІКОЛИ не комітити реальні значення (§8).

# --- Критичні (без них брифінг не надсилається; рання валідація, §4.1 п.0) ---
TELEGRAM_BOT_TOKEN=     # @BotFather
TELEGRAM_CHAT_ID=       # куди слати (DM зараз; супергрупа — Блок «Теми», нижче)
TELEGRAM_OWNER_USER_ID= # ХТО власник (owner-check у вебхуку/Mini App). У DM
#   зараз чисельно ТЕ САМЕ значення, що й TELEGRAM_CHAT_ID (chat_id одержувача
#   == user_id відправника в 1:1-чаті) — скопіюй звідти. НЕ змінюється, коли
#   TELEGRAM_CHAT_ID стане груповим id супергрупи (Блок «Теми») — це окремі
#   поняття, що просто досі збігались.
MINI_APP_URL=           # origin розгорнутого Worker (напр. https://svitanok.
#   <акаунт>.workers.dev) — кнопка «📊 Відкрити Mini App» у щоденному
#   сповіщенні (лише дата+кнопка, вміст брифінгу тепер повністю в Mini App).
#   Не задано -> сповіщення йде без кнопки (graceful, брифінг не блокується).

# --- Погода (OpenWeather) ---
# appid; ніколи не потрапляє в лог/стан (§19.4). ⚠️ Потрібна підписка «One Call
# by Call» (One Call 3.0) на цьому ж ключі — інакше /data/3.0/onecall дає 401 і
# погода тихо зникає. Free-тариф One Call = 1000 викликів/день (у коді жорсткий
# лічильник-запобіжник). AQI бере безкоштовний /data/2.5/air_pollution.
WEATHER_API_KEY=

# --- Курація новин через Claude Code (Pro), не платний API ---
CLAUDE_CODE_OAUTH_TOKEN= # `claude setup-token`

# --- Google Calendar + Gmail (опційно; увімкнути після публікації OAuth у Production) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=    # scope calendar.readonly + calendar.events + gmail.readonly
#   (Блок P2b+P2c), один консент, ОДИН refresh token покриває всі три разом —
#   read (orchestrator, брифінг: календар+пошта) і write (Worker-агент,
#   🤖Асистент: календар) — ті самі три значення треба ЩЕ РАЗ завести як
#   Worker-секрети (нижче), Worker сьогодні жодного з них не має.
#   mail-тріаж (P2c) — read-only, metadata-only (subject+from+snippet, НІКОЛИ
#   тіло листа) — вимкнено дефолтно (config.yml modules.mail.enabled: false)
#   до завершення ре-консенту зі scope gmail.readonly.

# --- Cloudflare Worker (web/wrangler.jsonc) — `wrangler secret put <NAME>`, НЕ тут ---
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID / TELEGRAM_OWNER_USER_ID — ті самі
#   значення, що вище.
# GH_DISPATCH_TOKEN       — PAT з правом workflow_dispatch на цей репо (точний cron).
# TELEGRAM_WEBHOOK_SECRET — довільний секрет власника (Блок P0, вебхук). Після
#   `wrangler secret put` — одноразово POST /api/telegram/setup з заголовком
#   X-Telegram-Bot-Api-Secret-Token: <те саме значення>, щоб зареєструвати webhook.
# LLM_HOST_URL / LLM_HOST_SECRET — LLM-фолбек нагадувань + tool-use асистент
#   (Блок P2/P2b, host/): власний VPS-реле на claude CLI (підписка, не платний
#   API) — деталі розгортання й генерації секрету в host/README.md. Без цих
#   двох Worker мовчки лишається на rule-based парсингу (graceful degradation).
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN — Блок P2b,
#   ті самі значення що вище (ширший скоуп) — читання/запис Google Calendar
#   з агента 🤖Асистент (readCalendar/proposeCalendarChanges). Без них
#   readCalendar тихо повертає null (агент про це скаже у відповіді).

# --- Telegram forum-супергрупа з темами (опційно) ---
# Без цих трьох усе працює як і зараз (DM, без тем). Заповнюються ПІСЛЯ
# створення супергрупи: власник тисне /whereami в кожній темі, копіює
# chat_id (стає новим TELEGRAM_CHAT_ID) і thread_id (нижче). Ті самі
# значення треба продублювати в GitHub Secrets для TOPIC_BRIEFING+TOPIC_ASSISTANT
# (brief.yml — Блок P2c, orchestrator шле пропозиції співбесід тим самим шляхом,
# що Worker-агент P2b; без TOPIC_ASSISTANT пропозиція просто не надсилається).
TOPIC_BRIEFING=   # thread_id теми «☀️ Брифінг» — куди йде ранковий брифінг + dead-man-алерт
TOPIC_ASSISTANT=  # thread_id теми «🤖 Асистент» — нагадування (Worker) + пропозиції співбесід (orchestrator)
TOPIC_ROADMAP=    # thread_id теми «🗺 Роадмеп» — зарезервовано під Блок P3
