# Svitanok — приклад env-змінних.
# Скопіюй у .env (gitignored) і заповни значеннями. У CI — через GitHub Secrets.
# НІКОЛИ не комітити реальні значення (§8).

# --- Критичні (без них брифінг не надсилається; рання валідація, §4.1 п.0) ---
TELEGRAM_BOT_TOKEN=     # @BotFather
TELEGRAM_CHAT_ID=       # знайти через `node scripts/check-telegram.mjs` (§6)

# --- Погода (OpenWeather) ---
# appid; ніколи не потрапляє в лог/стан (§19.4). ⚠️ Потрібна підписка «One Call
# by Call» (One Call 3.0) на цьому ж ключі — інакше /data/3.0/onecall дає 401 і
# погода тихо зникає. Free-тариф One Call = 1000 викликів/день (у коді жорсткий
# лічильник-запобіжник). AQI бере безкоштовний /data/2.5/air_pollution.
WEATHER_API_KEY=

# --- Курація новин через Claude Code (Pro), не платний API ---
CLAUDE_CODE_OAUTH_TOKEN= # `claude setup-token`

# --- Google Calendar (опційно; увімкнути після публікації OAuth у Production) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=    # scope calendar.readonly
