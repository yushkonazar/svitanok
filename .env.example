# Svitanok — приклад env-змінних.
# Скопіюй у .env (gitignored) і заповни значеннями. У CI — через GitHub Secrets.
# НІКОЛИ не комітити реальні значення (§8).

# --- Критичні (без них брифінг не надсилається; рання валідація, §4.1 п.0) ---
TELEGRAM_BOT_TOKEN=     # @BotFather
TELEGRAM_CHAT_ID=       # куди слати (DM зараз; супергрупа — Блок «Теми», нижче)
TELEGRAM_OWNER_USER_ID= # ХТО власник (owner-check у вебхуку/Mini App). У DM
#   зараз чисельно ТЕ САМЕ значення, що й TELEGRAM_CHAT_ID (chat_id одержувача
#   == user_id відправника в 1:1-чаті) — скопіюй звідти. НЕ змінюється, коли
#   TELEGRAM_CHAT_ID стане груповим id супергрупи (Блок «Теми») — це окремі
#   поняття, що просто досі збігались.

# --- Погода (OpenWeather) ---
# appid; ніколи не потрапляє в лог/стан (§19.4). ⚠️ Потрібна підписка «One Call
# by Call» (One Call 3.0) на цьому ж ключі — інакше /data/3.0/onecall дає 401 і
# погода тихо зникає. Free-тариф One Call = 1000 викликів/день (у коді жорсткий
# лічильник-запобіжник). AQI бере безкоштовний /data/2.5/air_pollution.
WEATHER_API_KEY=

# --- Курація новин через Claude Code (Pro), не платний API ---
CLAUDE_CODE_OAUTH_TOKEN= # `claude setup-token`

# --- Google Calendar (опційно; увімкнути після публікації OAuth у Production) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=    # scope calendar.readonly

# --- Cloudflare Worker (web/wrangler.jsonc) — `wrangler secret put <NAME>`, НЕ тут ---
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID / TELEGRAM_OWNER_USER_ID — ті самі
#   значення, що вище.
# GH_DISPATCH_TOKEN       — PAT з правом workflow_dispatch на цей репо (точний cron).
# TELEGRAM_WEBHOOK_SECRET — довільний секрет власника (Блок P0, вебхук). Після
#   `wrangler secret put` — одноразово POST /api/telegram/setup з заголовком
#   X-Telegram-Bot-Api-Secret-Token: <те саме значення>, щоб зареєструвати webhook.
# LLM_HOST_URL / LLM_HOST_SECRET — LLM-фолбек нагадувань (Блок P2, host/):
#   власний VPS-реле на claude CLI (підписка, не платний API) — деталі
#   розгортання й генерації секрету в host/README.md. Без цих двох Worker
#   мовчки лишається на rule-based парсингу (graceful degradation).

# --- Telegram forum-супергрупа з темами (опційно) ---
# Без цих трьох усе працює як і зараз (DM, без тем). Заповнюються ПІСЛЯ
# створення супергрупи: власник тисне /whereami в кожній темі, копіює
# chat_id (стає новим TELEGRAM_CHAT_ID) і thread_id (нижче). Ті самі
# значення треба продублювати в GitHub Secrets для TOPIC_BRIEFING (brief.yml).
TOPIC_BRIEFING=   # thread_id теми «☀️ Брифінг» — куди йде ранковий брифінг + dead-man-алерт
TOPIC_ASSISTANT=  # thread_id теми «🤖 Асистент» — куди спрацьовують нагадування
TOPIC_ROADMAP=    # thread_id теми «🗺 Роадмеп» — зарезервовано під Блок P3
