# Svitanok — приклад env-змінних.
# Скопіюй у .env (gitignored) і заповни значеннями. У CI — через GitHub Secrets.
# НІКОЛИ не комітити реальні значення (§8).

# --- Критичні (без них брифінг не надсилається; рання валідація, §4.1 п.0) ---
TELEGRAM_BOT_TOKEN=     # @BotFather
TELEGRAM_CHAT_ID=       # куди слати (DM зараз; супергрупа — Блок «Теми», нижче)
TELEGRAM_OWNER_USER_ID= # ХТО власник (owner-check у вебхуку/Mini App). У DM
#   зараз чисельно ТЕ САМЕ значення, що й TELEGRAM_CHAT_ID (chat_id одержувача
#   == user_id відправника в 1:1-чаті) — скопіюй звідти. НЕ змінюється, коли
#   TELEGRAM_CHAT_ID стане груповим id супергрупи (Блок «Теми») — це окремі
#   поняття, що просто досі збігались.
# TELEGRAM_ALLOWED_USER_IDS= # ОПЦІЙНО: ще учасники супергрупи, яким можна
#   користуватись ботом/Mini App (той самий доступ, що власник, — СПІЛЬНІ дані:
#   чек-іни/воронка/налаштування одні на всіх, не per-user). Через кому, напр.
#   "111111111,222222222". Не задано -> поведінка як зараз, лише
#   TELEGRAM_OWNER_USER_ID. Щоб дізнатись чийсь user id: нехай той учасник
#   напише @userinfobot у Telegram (не потребує додавання бота нікуди).
MINI_APP_URL=           # origin розгорнутого Worker (напр. https://svitanok.
#   <акаунт>.workers.dev) — кнопка «📊 Відкрити Mini App» у щоденному
#   сповіщенні (лише дата+кнопка, вміст брифінгу тепер повністю в Mini App).
#   Не задано -> сповіщення йде без кнопки (graceful, брифінг не блокується).
TELEGRAM_BOT_USERNAME=  # username бота БЕЗ "@" (напр. svitanok_bot). Дає
#   Direct Link Mini App (t.me/<username>?startapp) — ЄДИНИЙ спосіб відкрити
#   Mini App ЗІ збереженням initData із групового чату/теми (inline-кнопка
#   web_app працює лише в приватних чатах — BUTTON_TYPE_INVALID у групі
#   інакше). ОДНОРАЗОВИЙ owner-крок перед заповненням цього значення:
#   @BotFather -> обрати бота -> Bot Settings -> Configure Mini App -> Enable
#   Mini App -> URL = те САМЕ значення, що MINI_APP_URL вище. Не задано ->
#   кнопка з групи відкриється як звичайний лінк, БЕЗ initData (дашборд
#   покаже SAMPLE-демо замість реальних даних — не крашиться, лише деградує).

# --- Погода (OpenWeather) ---
# appid; ніколи не потрапляє в лог/стан (§19.4). ⚠️ Потрібна підписка «One Call
# by Call» (One Call 3.0) на цьому ж ключі — інакше /data/3.0/onecall дає 401 і
# погода тихо зникає. Free-тариф One Call = 1000 викликів/день (у коді жорсткий
# лічильник-запобіжник). AQI бере безкоштовний /data/2.5/air_pollution.
WEATHER_API_KEY=
#
# Локації погоди (JSON-масив {lat, lon, name}). НЕ обовʼязково: без цієї змінної
# працюють публічні обласні центри з config.yml (Львів + Рівне).
#
# ⚠️ Живе саме тут, а не в config.yml, свідомо: точні домашні координати — це
# адреса, і закомічена вона робить репозиторій вказівником на те, де живе
# родина. Ставиться у ДВОХ місцях (як і решта спільних секретів): GitHub
# Secrets для оркестратора і `wrangler secret put OWNER_LOCATIONS` для Worker'а.
# Не поставиш у Worker — Mini App показуватиме погоду по фолбеку, і це буде
# видно одразу, а не тихо.
#
# OWNER_LOCATIONS=[{"lat":49.8397,"lon":24.0297,"name":"Львів"},{"lat":51.12,"lon":26.46,"name":"Село"}]
OWNER_LOCATIONS=

# --- Курація новин через Claude Code (Pro), не платний API ---
CLAUDE_CODE_OAUTH_TOKEN= # `claude setup-token`

# --- Переклад світових новин (Google Cloud Translation, ОПЦІЙНО) ---
# Прозові world-теми (Світ/Наука/Здоровʼя/Культура/Бізнес/Довкілля/Тех.io/
# Футбол — config.yml, поле `translate: true` на конкретних рядках) title+why
# з en на uk. Не задано -> без перекладу, ті самі теми показуються англійською
# (graceful degrade, нічого не ламається). Basic v2 REST, простий API-ключ у
# query (НЕ той самий флоу, що GOOGLE_CLIENT_ID/SECRET/REFRESH_TOKEN нижче —
# ті OAuth для Calendar/Gmail, цей — окремий сервісний ключ):
#   Google Cloud Console -> новий/наявний проєкт -> увімкнути "Cloud
#   Translation API" -> увімкнути білінг (безкоштовний тір 500К символів/міс,
#   без ризику оплати при такому обсязі) -> Credentials -> Create API key ->
#   обмежити ключ лише на Cloud Translation API.
#
# ⚠️ ПРОД — це НЕ цей файл і НЕ .env хоста: щоденний брифінг (разом із news)
# ганяє GitHub Actions (.github/workflows/brief.yml). Тож ключ треба завести
# як Repository secret на GitHub (Settings -> Secrets and variables -> Actions),
# і він мусить бути перелічений у блоці `env:` кроку "run briefing" — інакше
# до процесу не доїде (саме на цьому фіча тихо простояла з 04.08).
GOOGLE_TRANSLATE_API_KEY=

# --- Google Calendar + Gmail (опційно; увімкнути після публікації OAuth у Production) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=    # scope calendar.readonly + calendar.events + gmail.readonly
#   (Блок P2b+P2c), один консент, ОДИН refresh token покриває всі три разом —
#   read (orchestrator, брифінг: календар+пошта) і write (Worker-агент,
#   🤖Асистент: календар) — ті самі три значення треба ЩЕ РАЗ завести як
#   Worker-секрети (нижче), Worker сьогодні жодного з них не має.
#   mail-тріаж (P2c) — read-only, metadata-only (subject+from+snippet, НІКОЛИ
#   тіло листа) — вимкнено дефолтно (config.yml modules.mail.enabled: false)
#   до завершення ре-консенту зі scope gmail.readonly.

# --- Cloudflare Worker (web/wrangler.jsonc) — `wrangler secret put <NAME>`, НЕ тут ---
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID / TELEGRAM_OWNER_USER_ID / TELEGRAM_BOT_USERNAME —
#   ті самі значення, що вище (BOT_USERNAME потрібен і тут — кнопка «Mini App»
#   у відповіді на команду /settings).
# GH_DISPATCH_TOKEN       — PAT з правом workflow_dispatch на цей репо (точний cron).
# TELEGRAM_WEBHOOK_SECRET — довільний секрет власника (Блок P0, вебхук). Після
#   `wrangler secret put` — одноразово POST /api/telegram/setup з заголовком
#   X-Telegram-Bot-Api-Secret-Token: <те саме значення>, щоб зареєструвати webhook.
# LLM_HOST_URL / LLM_HOST_SECRET — LLM-фолбек нагадувань + tool-use асистент
#   (Блок P2/P2b, host/): власний VPS-реле на claude CLI (підписка, не платний
#   API) — деталі розгортання й генерації секрету в host/README.md. Без цих
#   двох Worker мовчки лишається на rule-based парсингу (graceful degradation).
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN — Блок P2b,
#   ті самі значення що вище (ширший скоуп) — читання/запис Google Calendar
#   з агента 🤖Асистент (readCalendar/proposeCalendarChanges). Без них
#   readCalendar тихо повертає null (агент про це скаже у відповіді).

# --- Telegram forum-супергрупа з темами (опційно) ---
# Без цих усе працює як і зараз (DM, без тем). Заповнюються ПІСЛЯ створення
# супергрупи: власник тисне /whereami в кожній темі, копіює chat_id (стає
# новим TELEGRAM_CHAT_ID) і thread_id (нижче). Ті самі значення треба
# продублювати в GitHub Secrets для TOPIC_BRIEFING+TOPIC_ASSISTANT+TOPIC_SYSTEM
# (brief.yml — orchestrator читає їх окремо від Worker-секретів; без
# TOPIC_ASSISTANT пропозиція співбесіди просто не надсилається, без
# TOPIC_SYSTEM fail-notify лишається unscoped/General — обидва graceful,
# але власник має завести значення В ОБОХ місцях, інакше поведінка
# розійдеться між orchestrator (GitHub Actions) і Worker (Cloudflare)).
TOPIC_BRIEFING=   # thread_id теми «☀️ Брифінг» — куди йде ранковий брифінг + недільний підсумок тижня
TOPIC_ASSISTANT=  # thread_id теми «🤖 Асистент» — нагадування (Worker) + пропозиції співбесід (orchestrator)
TOPIC_ROADMAP=    # thread_id теми «🗺 Роадмеп» — зарезервовано під Блок P3
TOPIC_SYSTEM=     # thread_id теми «⚠️ Система» (Фаза B) — fail-notify (orchestrator) + dead-man-алерт
                   # (Worker). Не задано -> dead-man фолбечить на TOPIC_BRIEFING (стара поведінка),
                   # fail-notify лишається unscoped/General.
