{
  "name": "svitanok-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Telegram Mini App дашборд Svitanok — React+Tailwind (роадмеп v3, група E). Білдиться у ../public/app, живе на /app поруч зі старим index.html.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
