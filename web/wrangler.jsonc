{
  "name": "svitanok",
  "compatibility_date": "2025-06-01",
  "main": "worker.js",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "kv_namespaces": [{ "binding": "BRIEFING", "id": "389ff22c124a476bb18d2f5e6a5334c0" }],
  // "*/5 * * * *" — нагадування (Блок P2a) + ранковий dispatch брифінгу у вікні
  // 08:00–12:00 Київ (A2: одна погодинна спроба гинула від jitter'а крону Free).
  // Погодинні (DST-покриття 08:00 Київ ± зсув) лишились під dead-man о 10:00.
  "triggers": { "crons": ["0 5 * * *", "0 6 * * *", "0 7 * * *", "0 8 * * *", "*/5 * * * *"] },
}
