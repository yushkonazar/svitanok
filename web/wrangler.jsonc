{
  "name": "svitanok",
  "compatibility_date": "2025-06-01",
  "main": "worker.js",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Публічні *.workers.dev вимкнені (аудит S3): поки вони відповідають, будь-які
  // налаштування зони yushko.dev — WAF, rate limit на /api/* — обходяться одним
  // зверненням на стару адресу, бо workers.dev до зони не належить. Тримаємо це
  // ТУТ, а не перемикачем у дашборді: деплой іде автоматично з main, тобто по
  // суті `wrangler deploy`, і він застосував би дефолт (true) назад.
  //
  // `preview_urls` за замовчуванням дорівнює `workers_dev`, але вказано явно —
  // щоб повернення однієї галки не вмикало мовчки другу.
  //
  // Кастомний домен (svitanok.yushko.dev) доданий через дашборд і лишається
  // недоторканим: ключа `routes` тут немає, тож wrangler маршрути не перезаписує.
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "BRIEFING", "id": "389ff22c124a476bb18d2f5e6a5334c0" }],
  // D1 нового асистента (редизайн, етап 1). Схема — final/07-schema §1; міграції
  // застосовує workflow .github/workflows/migrate.yml (push у main). У shadow
  // сюди пишуть телеметрія тіків/прогонів і policy; старий агент її не читає.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svitanok",
      "database_id": "ac371a2e-47eb-44a2-ae9e-6c205a16f919",
      "migrations_dir": "core/migrations",
    },
  ],
  // Прапорець редизайну (01-architecture §5): off → shadow → on. Живе ТУТ, а не
  // в дашборді: деплой іде з main через wrangler deploy, який заміщує vars
  // конфігом, — значення з дашборда не пережило б наступного деплою.
  //
  // `on` з етапу 2 PR-7b: вебхук іде НОВИМ шляхом для всіх повідомлень (а не
  // лише за префіксом `v2:`), легасі-цикл крону більше не запускається (його
  // задачі виконує планувальник), і KV-гілка нагадувань мовчить - джерелом
  // стала D1. Відкат - одне слово тут: `shadow` повертає префіксний режим і
  // легасі-цикл, не чіпаючи ані сховищ, ані мозку.
  "vars": {
    "ASSISTANT_V2": "on",
    // Адреса мозку за Tunnel (01 §2.2). Поява цього var ОЗБРОЮЄ задачу
    // brain-health (етап 1 PR-9: no-op, поки порожньо): щоп'ять хвилин проба
    // /health з Access-парою і звірка з brainExpected у KV. Мозок задеплоєно
    // 27.08 (етап 2 PR-1) - канал ядро→мозок вмикається цим рядком.
    "BRAIN_URL": "https://brain.yushko.dev",
  },
  // Памʼять асистента (ADR-038, етап 2 PR-2): згортки тредів → ембединги
  // bge-m3 (Workers AI) → Vectorize svitanok-memory (1024, cosine; індекс
  // створено wrangler-ом 27.08). Обидві привʼязки читає лише memory-модуль.
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "svitanok-memory" }],
  "ai": { "binding": "AI" },
  // Durable Object прогону асистента (Фаза 4 аудиту): авторитетний лічильник
  // кроків замість best-effort надгробка в KV. `storage:"sqlite"` — не смак:
  // на Workers Free доступні ЛИШЕ SQLite-бекенди DO. Оголошення через `exports`
  // (декларативне) замість легасі-масиву `migrations` — так радить поточна
  // документація для нових класів; обидва способи взаємовиключні.
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_RUN", "class_name": "AgentRun" },
      // Планувальник редизайну (етап 1, PR-2): таблиця jobs + один alarm у
      // власному SQLite DO; тікає лише при ASSISTANT_V2=shadow/on.
      { "name": "SCHEDULER", "class_name": "SchedulerDO" },
      // Реєстр прогонів (етап 1, PR-4): активний набір + телеметрія в D1 runs;
      // поки лише запис для старого агента, слоти/handshake - етап 2.
      { "name": "RUN_REGISTRY", "class_name": "RunRegistryDO" },
    ],
  },
  "exports": {
    "AgentRun": { "type": "durable-object", "storage": "sqlite" },
    "SchedulerDO": { "type": "durable-object", "storage": "sqlite" },
    "RunRegistryDO": { "type": "durable-object", "storage": "sqlite" },
  },
  // ОДИН крон (A2): нагадування (Блок P2a) + dispatch брифінгу у вікні 08:00–11:00
  // Київ + dead-man від 12:00 — кожна задача гейтиться за kyivHour() у момент
  // виконання й ідемпотентна за добу. Погодинні крони (0 5/6/7/8 UTC) прибрано:
  // вони існували як DST-костиль під ОДНУ точну спробу, і саме та єдина спроба
  // гинула від jitter'а крону Cloudflare Free (14.07 брифінг спізнився на ~50 хв).
  "triggers": { "crons": ["*/5 * * * *"] },
}
