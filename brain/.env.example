# Svitanok brain VPS environment. Copy this file only to
# /opt/svitanok-brain-shared/brain.env, set owner brain:brain and mode 0600.
# Never commit the resulting file or put these values in Worker/GitHub secrets.

INTERNAL_HMAC_KEY=
INTERNAL_API_URL=https://your-worker-domain.example
# BRAIN_ACCESS_CLIENT_ID=
# BRAIN_ACCESS_CLIENT_SECRET=

# Safe first rollout: both runtimes are present, but only the named private
# chat/profile uses OpenAI. Keep scheduled profiles off this list.
AI_PROVIDER=hybrid
OPENAI_ROLLOUT=canary
OPENAI_API_KEY=
OPENAI_CANARY_THREAD_IDS=
OPENAI_CANARY_PROFILES=chat,quick

# Model classes. Fast is for greetings/summaries, standard for normal chat,
# advanced only for review/reasoning profiles.
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_STANDARD=gpt-6-sol
OPENAI_MODEL_ADVANCED=gpt-6-astra
OPENAI_REASONING_EFFORT=medium

# Optional evidence-only shadow lane. Claude still replies; OpenAI gets the
# same text only for this private tool-free profile, receives no Core tools,
# and its generated text is discarded. Set both or neither.
# OPENAI_SHADOW_THREAD_IDS=
# OPENAI_SHADOW_PROFILES=quick

# Full cutover is an explicit later change:
# AI_PROVIDER=openai
# OPENAI_ROLLOUT=full
