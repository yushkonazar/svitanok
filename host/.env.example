# svitanok-llm-host — приклад env для systemd EnvironmentFile.
# Скопіюй у .env (gitignored, лишається лише на сервері) і заповни.
# НІКОЛИ не комітити реальні значення.

# Спільний секрет Worker<->хост (заголовок X-Llm-Host-Secret). Згенерувати:
#   openssl rand -hex 32
# Той самий підхід, що й TELEGRAM_WEBHOOK_SECRET у головному .env.example.
LLM_HOST_SECRET=

# Довгоживучий OAuth-токен ПІДПИСКИ (не платний API-ключ). Отримати:
#   claude setup-token
# Список задач (не GH Actions) — це саме той самий механізм, що вже
# використовує brief.yml для курації новин, лише інший процес-власник.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Опційно (є розумні дефолти в server.mjs) ---
# PORT=8787
# CLAUDE_BIN=claude              # абсолютний шлях, якщо не на PATH systemd-юзера
# CLAUDE_TIMEOUT_MS=30000
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=20
