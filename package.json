{
  "name": "svitanok",
  "version": "0.1.0",
  "description": "Персональний AI-асистент у Telegram (GitHub Actions + OpenAI Responses)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "tsc --noEmit && tsc -p web",
    "typecheck:web": "tsc -p web",
    "build:web": "npm --prefix web/app ci && npm --prefix web/app run build",
    "test": "npm run contract:tools && vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:coverage": "vitest run --coverage",
    "eval:openai": "tsx scripts/openai-eval.mts",
    "eval:file-search": "node scripts/openai-file-search-experiment.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contract:tools": "node --experimental-loader ./scripts/cloudflare-stub-loader.mjs scripts/generate-tool-contract.mjs",
    "contract:tools:write": "node --experimental-loader ./scripts/cloudflare-stub-loader.mjs scripts/generate-tool-contract.mjs --write",
    "restore:drill": "node scripts/restore-drill.mjs",
    "dry-run": "tsx src/orchestrator.ts --dry-run",
    "start": "tsx src/orchestrator.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{tsx,css,html}": [
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "js-yaml": "^5.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@cloudflare/workers-types": "5.20261002.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
